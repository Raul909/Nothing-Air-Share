<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Title dot-matrix header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOTHING"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AIRSHARE"
        android:textColor="#FF0000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Status indicator widget -->
    <LinearLayout
        android:id="@+id/widgetStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111111"
        android:padding="20dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS"
            android:textColor="#888888"
            android:textSize="12sp"
            android:fontFamily="monospace"/>

        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIRDROP SHARING ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready for transfers and clipboard sync"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <!-- Progress Bar for File Transfers -->
        <ProgressBar
            android:id="@+id/progressBarTransfer"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:progressDrawable="@android:drawable/progress_horizontal"
            android:progressTint="#FF0000"
            android:progress="0"
            android:visibility="gone"
            tools:visibility="visible"/>
    </LinearLayout>

    <!-- Nearby Devices Section -->
    <TextView
        android:id="@+id/tvDevicesHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEARBY DEVICES"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/widgetStatus"
        app:layout_constraintStart_toStartOf="parent"/>

    <ScrollView
        android:id="@+id/svDevices"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="8dp"
        android:background="#111111"
        app:layout_constraintTop_toBottomOf="@id/tvDevicesHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/llDevicesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            
            <TextView
                android:id="@+id/tvNoDevices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scanning for Mac / iOS devices..."
                android:textColor="#555555"
                android:textSize="14sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </ScrollView>

    <!-- Clipboard Sync Section -->
    <EditText
        android:id="@+id/etInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Type text to sync..."
        android:textColor="#FFFFFF"
        android:textColorHint="#555555"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="monospace"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/svDevices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="COPY TO SYNC"
            android:backgroundTint="#FFFFFF"
            android:textColor="#000000"
            android:fontFamily="monospace"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnPaste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PASTE LAST"
            android:backgroundTint="#222222"
            android:textColor="#FFFFFF"
            android:fontFamily="monospace"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Footer info -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONNECTED OVER LOCAL WI-FI / ADB"
        android:textColor="#444444"
        android:textSize="10sp"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
